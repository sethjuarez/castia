FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<deployment-name>

# Optional: comma-separated toolbox MCP tool names to expose to Prompty as
# function tools. Leave empty for a no-tool Prompty turn.
PROMPTY_TOOLBOX_ALLOWED_TOOLS=

# Optional: opt into content-bearing GenAI/Prompty traces for local trace tests.
# The hosted sample enables this in azure.yaml because it is trace-focused.
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true
