---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Castia Customize additions" description="Plan for Castia Copilot App Customize additions.">
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Customize</p>
        <h1>Install the Copilot pieces from one place.</h1>
        <p class="lede">
          The docs site should point to a Copilot plugin. The plugin should carry the Castia canvas, skills, prompts, and repo setup guidance.
        </p>
      </div>
      <div class="hero-visual">
        <img class="visual-field" src={`${base}assets/foundry-ribbon.svg`} alt="" width="900" height="640" />
        <img class="mark" src={`${base}assets/castia-mark.svg`} alt="Castia split mold anvil mark" width="340" height="340" />
      </div>
    </section>

    <section class="grid" aria-label="Customize additions">
      <article class="card color-card">
        <span class="number">1</span>
        <h3>Agent Lab canvas</h3>
        <p>Local chat, traces, tool calls, readiness checks, and validation output for a scenario agent.</p>
      </article>
      <article class="card color-card">
        <span class="number">2</span>
        <h3>Skills and prompts</h3>
        <p>Ship the lifecycle and optimizer skills with build and test prompts for a fresh session.</p>
      </article>
      <article class="card color-card">
        <span class="number">3</span>
        <h3>Scenario setup</h3>
        <p>Give the target repo templates for instructions, model policy, tests, and live-work gates.</p>
      </article>
    </section>

    <section class="section" aria-labelledby="install-title">
      <h2 id="install-title">Website install path</h2>
      <div class="prompt-panel">
        <div class="prompt-title">
          <span>future flow</span>
          <span>Customize</span>
        </div>
        <pre><code>1. Install the Castia Copilot plugin from Customize.
2. Copy scenario starter files into the target repo.
3. Open the target repo in Copilot App.
4. Run the build prompt.
5. Try the local agent in the Castia Agent Lab canvas.
6. Deploy only after local proof looks good.</code></pre>
      </div>
      <p class="note">
        The website should not provision Azure resources or grant permissions. It should explain the install and send the user to Customize.
      </p>
    </section>

    <section class="section" aria-labelledby="plugin-title">
      <h2 id="plugin-title">Plugin shape</h2>
      <div class="prompt-panel">
        <div class="prompt-title">
          <span>plugins/castia-agent-lab</span>
          <span>planned</span>
        </div>
        <pre><code>plugins/castia-agent-lab/
|-- plugin.json
|-- extensions/
|   `-- castia-agent-lab/
|       `-- extension.mjs
|-- skills/
|   |-- castia-lifecycle/
|   `-- castia-optimizer/
`-- prompts/
    |-- build-castia-agent.prompt.md
    `-- test-castia-agent.prompt.md</code></pre>
      </div>
    </section>

    <section class="section" aria-labelledby="scope-title">
      <h2 id="scope-title">Canvas scope</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Show</th>
              <th>Gate</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Agent endpoint, health, prompts, responses, tool calls, tests, eval results, and deployment readiness.</td>
              <td>Azure provisioning, deployment, Teams publishing, permissions, and spend.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>
