---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const markSrc = `${import.meta.env.BASE_URL}assets/castia-mark.svg`;
---

<a href={siteTitleHref} class="site-title castia-site-title sl-flex">
  <img src={markSrc} width="36" height="36" alt="" aria-hidden="true" />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: 0.625rem;
      color: var(--castia-accent);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }

    .site-title:hover {
      color: var(--castia-accent-hover);
    }

    img {
      width: 2.25rem;
      height: 2.25rem;
      flex: none;
      object-fit: contain;
      filter: drop-shadow(0 8px 14px var(--castia-accent-soft));
    }

    span {
      display: block;
      overflow: hidden;
      font-family: "Cooper Black", "Segoe UI Black", "Arial Black", var(--__sl-font);
      font-size: 1.7rem;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.08em;
    }
  }
</style>
