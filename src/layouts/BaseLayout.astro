---
const { title, description = "Cast agents into Foundry." } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}assets/castia-mark.svg`} />
    <script is:inline>
      (() => {
        const param = new URLSearchParams(window.location.search).get("clawpilotTheme");
        const theme =
          param || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <div class="page-shell" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Castia home">
        <img src={`${base}assets/castia-mark.svg`} alt="" width="44" height="44" />
        <span>castia</span>
      </a>
      <nav aria-label="Primary">
        <a href={`${base}install/`}>Install</a>
        <a href={`${base}copilot-extras/`}>Copilot extras</a>
        <a href={`${base}framework/`}>Framework</a>
        <a href={`${base}customize/`}>Customize</a>
        <a href={`${base}copilot-app/`}>Copilot App</a>
        <a href="https://github.com/sethjuarez/castia">GitHub</a>
      </nav>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --cp-bg: #f7f4ef;
    --cp-bg-elevated: #fcfbf8;
    --cp-surface: #ffffff;
    --cp-surface-soft: #f5f5f5;
    --cp-border: #dedede;
    --cp-border-strong: #919191;
    --cp-text: #242424;
    --cp-text-muted: #5c5c5c;
    --cp-text-soft: #6f6f6f;
    --cp-accent: #b11f4b;
    --cp-accent-hover: #9a1a41;
    --cp-accent-soft: rgba(177, 31, 75, 0.08);
    --cp-accent-fg: #ffffff;
    --cp-success: #16a34a;
    --cp-danger: #dc2626;
    --cp-warning: #f59e0b;
    --cp-link: #0078d4;
    --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
    --cp-overlay: rgba(255, 255, 255, 0.8);
    --cp-panel: rgba(255, 255, 255, 0.86);
    --cp-panel-strong: rgba(255, 255, 255, 0.96);
    --cp-sheen: rgba(255, 255, 255, 0.55);
    --cp-highlight: rgba(177, 31, 75, 0.12);
  }
  html[data-theme="dark"] {
    color-scheme: dark;
    --cp-bg: #3d3b3a;
    --cp-bg-elevated: #343231;
    --cp-surface: #292929;
    --cp-surface-soft: #2e2e2e;
    --cp-border: #474747;
    --cp-border-strong: #5f5f5f;
    --cp-text: #dedede;
    --cp-text-muted: #919191;
    --cp-text-soft: #b0b0b0;
    --cp-accent: #fd8ea1;
    --cp-accent-hover: #fb7b91;
    --cp-accent-soft: rgba(253, 142, 161, 0.14);
    --cp-accent-fg: #1a1a1a;
    --cp-success: #4ade80;
    --cp-danger: #f87171;
    --cp-warning: #fbbf24;
    --cp-link: #4da6ff;
    --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
    --cp-overlay: rgba(41, 41, 41, 0.88);
    --cp-panel: rgba(41, 41, 41, 0.72);
    --cp-panel-strong: rgba(41, 41, 41, 0.96);
    --cp-sheen: rgba(255, 255, 255, 0.04);
    --cp-highlight: rgba(253, 142, 161, 0.12);
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--cp-bg);
    color: var(--cp-text);
    font-family: "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif;
  }
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(circle at 78% 8%, var(--cp-highlight), var(--cp-bg) 34%),
      linear-gradient(180deg, var(--cp-bg-elevated), var(--cp-bg));
  }
  .page-shell {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--cp-border) 1px, var(--cp-bg) 1px),
      linear-gradient(90deg, var(--cp-border) 1px, var(--cp-bg) 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 68%);
    opacity: 0.24;
  }
  a {
    color: var(--cp-link);
  }
  code {
    font-family: Consolas, "Courier New", Courier, monospace;
    background: var(--cp-surface-soft);
    border: 1px solid var(--cp-border);
    border-radius: 0.625rem;
    padding: 2px 6px;
  }
  pre {
    overflow-x: auto;
    background: var(--cp-surface-soft);
    border: 1px solid var(--cp-border);
    border-radius: 16px;
    padding: 20px;
  }
  pre code {
    padding: 0;
    border: 0;
    background: transparent;
  }
  .site-header {
    max-width: 1120px;
    margin: 0 auto;
    padding: 20px 24px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--cp-text);
    text-decoration: none;
    font-size: 24px;
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .brand img {
    display: block;
  }
  nav {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: flex-end;
    font-size: 14px;
    background: var(--cp-panel);
    border: 1px solid var(--cp-border);
    border-radius: 999px;
    padding: 10px 14px;
    backdrop-filter: blur(14px);
  }
  nav a {
    color: var(--cp-text-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--cp-text);
  }
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 56px 24px 80px;
  }
  .eyebrow {
    margin: 0 0 16px;
    color: var(--cp-text-muted);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    max-width: 840px;
    font-size: clamp(48px, 8vw, 92px);
    line-height: 0.94;
    letter-spacing: -0.06em;
  }
  h2 {
    margin: 0 0 12px;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  h3 {
    margin: 0 0 8px;
    font-size: 18px;
  }
  p {
    line-height: 1.65;
  }
  .lede {
    max-width: 720px;
    margin: 24px 0 0;
    color: var(--cp-text-muted);
    font-size: 20px;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: 48px;
    align-items: center;
  }
  .hero-copy {
    min-width: 0;
  }
  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 420px;
    border: 1px solid var(--cp-border);
    border-radius: 28px;
    background: var(--cp-panel-strong);
    box-shadow: 0 0 2px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.14);
    overflow: hidden;
  }
  .hero-visual::before,
  .hero-visual::after {
    content: "";
    position: absolute;
    border: 1px solid var(--cp-border);
    background: var(--cp-surface-soft);
    border-radius: 999px;
  }
  .hero-visual::before {
    width: 320px;
    height: 320px;
  }
  .hero-visual::after {
    width: 220px;
    height: 220px;
    transform: translate(72px, -58px);
    background: var(--cp-highlight);
  }
  .visual-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.86;
  }
  .hero-visual .mark {
    position: relative;
    z-index: 1;
    width: min(72%, 300px);
    height: auto;
    padding: 44px;
    border: 1px solid var(--cp-border);
    border-radius: 28px;
    background: var(--cp-panel-strong);
    box-shadow: 0 0 2px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.14);
  }
  .pill-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 22px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--cp-border);
    border-radius: 999px;
    background: var(--cp-panel);
    color: var(--cp-text-muted);
    font-size: 13px;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 0.625rem;
    border: 1px solid var(--cp-border);
    background: var(--cp-surface);
    color: var(--cp-text);
    text-decoration: none;
    font-weight: 600;
  }
  .button.primary {
    border-color: var(--cp-accent);
    background: var(--cp-accent);
    color: var(--cp-accent-fg);
  }
  .button.primary::after {
    content: "→";
    margin-left: 10px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }
  .card {
    background: var(--cp-surface);
    border: 1px solid var(--cp-border);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 0 2px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.14);
  }
  .card.accent {
    background: var(--cp-panel-strong);
    border-color: var(--cp-border-strong);
  }
  .card.color-card {
    position: relative;
    overflow: hidden;
  }
  .card.color-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 5px;
    background: var(--cp-accent);
  }
  .number {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: var(--cp-accent-soft);
    color: var(--cp-accent);
    font-family: Consolas, "Courier New", Courier, monospace;
    font-size: 13px;
    font-weight: 700;
  }
  .card p {
    margin: 0;
    color: var(--cp-text-muted);
  }
  .hero-card {
    margin-top: 56px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 32px;
    align-items: center;
  }
  .split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 24px;
    align-items: start;
  }
  .prompt-panel {
    background: var(--cp-surface);
    border: 1px solid var(--cp-border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 0 2px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.14);
  }
  .prompt-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--cp-border);
    color: var(--cp-text-muted);
    font-family: Consolas, "Courier New", Courier, monospace;
    font-size: 12px;
  }
  .prompt-panel pre {
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  .doc-list {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }
  .doc-link {
    display: grid;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--cp-border);
    border-radius: 16px;
    background: var(--cp-surface);
    color: var(--cp-text);
    text-decoration: none;
    box-shadow: 0 0 2px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.14);
  }
  .doc-link:hover {
    border-color: var(--cp-border-strong);
  }
  .doc-link strong {
    font-size: 18px;
  }
  .doc-link span {
    color: var(--cp-text-muted);
    line-height: 1.55;
  }
  .hero-mark {
    width: min(100%, 340px);
    justify-self: center;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--cp-border);
    border-radius: 16px;
    background: var(--cp-surface);
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--cp-border);
    text-align: left;
    vertical-align: top;
  }
  tr:last-child td {
    border-bottom: 0;
  }
  th {
    color: var(--cp-text-muted);
    font-size: 13px;
    font-weight: 600;
  }
  .section {
    margin-top: 56px;
  }
  .note {
    color: var(--cp-text-muted);
  }
  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }
    nav {
      justify-content: flex-start;
    }
    .grid,
    .hero,
    .hero-card,
    .split {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      min-height: 320px;
    }
    main {
      padding-top: 48px;
    }
  }
</style>
