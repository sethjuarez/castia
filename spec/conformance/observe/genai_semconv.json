  "tool_error_gate": [
    {
      "name": "KB PaymentRequired run is invalid",
      "max_error_rate": 0.1,
      "min_calls": 0,
      "records": [
        {
          "schema": "castia.tool_capture/v1",
          "tool_calls": [
            {"name": "knowledge_base_retrieve", "status": "error", "error": {"type": "http_402", "message": "PaymentRequired"}},
            {"name": "knowledge_base_retrieve", "status": "ok", "tool_reported_ok": true},
            {"name": "lookup_order", "status": "ok", "tool_reported_ok": false}
          ]
        },
        {
          "name": "execute_tool knowledge_base_retrieve",
          "status": "ok",
          "attributes": {"gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "knowledge_base_retrieve"}
        },
        {
          "name": "castia.model.respond",
          "status": "ok",
          "attributes": {"gen_ai.operation.name": "chat"}
        }
      ],
      "expected": {
        "schema": "castia.tool_error_gate/v1",
        "total": 4,
        "errors": 2,
        "error_rate": 0.5,
        "max_error_rate": 0.1,
        "min_calls": 0,
        "valid": false,
        "reason": "tool_error_rate_exceeded",
        "by_type": {"http_402": 1, "tool_reported_error": 1},
        "by_tool": {"knowledge_base_retrieve": 1, "lookup_order": 1}
      }
    },
    {
      "name": "error rate at the threshold stays valid",
