{
  "schema": "castia.conformance.genai_semconv/v1",
  "semconv_version": "1.42.0",
  "schema_url": "https://opentelemetry.io/schemas/1.42.0",
  "provider": "microsoft.foundry",
  "text_messages": [
    {
      "role": "user",
      "text": "hello",
      "finish_reason": null,
      "expected": [{"role": "user", "parts": [{"type": "text", "content": "hello"}]}]
    },
    {
      "role": "assistant",
      "text": "hi there",
      "finish_reason": "stop",
      "expected": [
        {
          "role": "assistant",
          "parts": [{"type": "text", "content": "hi there"}],
          "finish_reason": "stop"
        }
      ]
    }
  ],
  "system_instructions": [
    {
      "text": "Be terse.",
      "expected": [{"type": "text", "content": "Be terse."}]
    }
  ],
  "request_parameters": [
    {
      "name": "zero values are recorded, unset values dropped",
      "params": {"temperature": 0, "top_p": 0.5, "seed": 0, "max_output_tokens": 256, "presence_penalty": null},
      "expected": {
        "gen_ai.request.temperature": 0,
        "gen_ai.request.top_p": 0.5,
        "gen_ai.request.seed": 0,
        "gen_ai.request.max_tokens": 256
      }
    },
    {
      "name": "booleans and strings are not numbers",
      "params": {"temperature": false, "top_k": "3", "stop": "END"},
      "expected": {"gen_ai.request.stop_sequences": ["END"]}
    },
    {
      "name": "max_output_tokens wins over max_tokens",
      "params": {"max_output_tokens": 10, "max_tokens": 20},
      "expected": {"gen_ai.request.max_tokens": 10}
    }
  ],
