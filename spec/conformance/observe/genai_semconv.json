      "min_calls": 0,
      "records": [
        {
          "name": "execute_tool kb",
          "status": "error",
          "attributes": {"gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": "kb", "error.type": "http_402"}
        },
        {"name": "kb", "item_type": "mcp_call", "status": "ok", "error_type": null},
        {"name": "kb", "item_type": "mcp_call", "status": "ok", "error_type": null},
        {"name": "kb", "item_type": "mcp_call", "status": "ok", "error_type": null}
      ],
      "expected": {
        "schema": "castia.tool_error_gate/v1",
        "total": 4,
        "errors": 1,
        "error_rate": 0.25,
        "max_error_rate": 0.25,
        "min_calls": 0,
        "valid": true,
        "reason": null,
        "by_type": {"http_402": 1},
        "by_tool": {"kb": 1}
